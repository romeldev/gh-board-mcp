{
  "name": "gh-board-mcp",
  "version": "0.1.0",
  "description": "MCP server for managing GitHub Projects v2 as a personal kanban board",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gh-board-mcp": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "github",
    "projects",
    "kanban",
    "board",
    "model-context-protocol"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.16.0",
    "@octokit/graphql": "^8.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
